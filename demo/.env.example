# Variables for the Magnolia demo container (set them as Railway service variables).
# Never commit real values.

# Demo accounts, created on every start if missing (existing accounts are never changed).
# Sign in at /.magnolia/admincentral with the e-mail address as user name.
# Magnolia's rules: any non-empty password; the e-mail must not contain < > & " ' $ % ! # ? , ; : * ~ / \ | ^ = [ ] { } ( ) ` or spaces.
# Once DEMO_ADMIN_* exists, Magnolia's built-in superuser/superuser account is disabled.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# Supertext. Account: https://www.supertext.com/person/en/account/signin
# API key: https://www.supertext.com/en/integrations/api (requires the Admin role)
SUPERTEXT_API_KEY=
# SUPERTEXT_API_ENDPOINT=https://api.supertext.com/v1/

# Railway: port Tomcat listens on (match the domain's target port), Java heap and the Dockerfile.
PORT=8080
MAGNOLIA_HEAP=1536m
RAILWAY_DOCKERFILE_PATH=demo/Dockerfile
