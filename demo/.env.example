# Variables for the Magnolia demo container (set them as Railway service variables).
# Never commit real values.

# Demo accounts, created on every start if missing (existing accounts are never changed).
# Sign in at /.magnolia/admincentral with the e-mail address as user name.
# Magnolia's rules: any non-empty password; the e-mail must not contain < > & " ' $ % ! # ? , ; : * ~ / \ | ^ = [ ] { } ( ) ` or spaces.
# Once DEMO_ADMIN_* exists, Magnolia's built-in superuser/superuser account is disabled.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# Supertext. No Supertext account yet? Create one at https://www.supertext.com/person/en/account/signin
# Generate your API key at https://www.supertext.com/en/integrations/api
# (supertext.com → Integrations → API; requires the Admin role).
SUPERTEXT_API_KEY=
# SUPERTEXT_API_ENDPOINT=https://api.supertext.com/v1/
# Optional: another review service for languages with "Translation review" ticked
# (default: Supertext's review service)
# SUPERTEXT_REVIEW_URL=http://localhost:3000/v1/

# Version reports to the Supertext Commando Center (on by default; 0 turns them and /.supertext/ping off).
# SUPERTEXT_VERSION_REPORTS=0
# Tests only: where reports go instead of the live center (the stand-in answers POST /report).
# SUPERTEXT_REPORT_URL=http://host.docker.internal:8765/report

# Railway: port Tomcat listens on (match the domain's target port), Java heap and the Dockerfile.
PORT=8080
MAGNOLIA_HEAP=1536m
RAILWAY_DOCKERFILE_PATH=demo/Dockerfile
