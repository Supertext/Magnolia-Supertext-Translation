<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Supertext Translation for Magnolia CMS: a Magnolia module (jar) that adds
    "Translate with Supertext" to the Pages app. The version below is the module
    version (Magnolia reads it from META-INF/magnolia/supertext-translation.xml,
    filled in at build time). See docs/DEVELOPER.md.
  -->
  <groupId>com.supertext</groupId>
  <artifactId>magnolia-supertext-translation</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>Supertext Translation for Magnolia</name>
  <description>Translates Magnolia pages with Supertext AI.</description>
  <url>https://github.com/Supertext/Magnolia-Supertext-Translation</url>

  <scm>
    <url>https://github.com/Supertext/Magnolia-Supertext-Translation</url>
    <connection>scm:git:https://github.com/Supertext/Magnolia-Supertext-Translation.git</connection>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <magnolia.version>6.4.10</magnolia.version>
    <magnolia.pages.version>6.4.5</magnolia.pages.version>
    <magnolia.site.version>3.0.1</magnolia.site.version>
    <!-- Provided by Magnolia: keep it at the version magnolia.version ships (mvn dependency:tree). -->
    <vaadin.version>8.30.0</vaadin.version>
    <junit.version>6.1.3</junit.version>
  </properties>

  <repositories>
    <repository>
      <id>magnolia.public</id>
      <url>https://nexus.magnolia-cms.com/content/groups/public</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
    <repository>
      <id>vaadin-addons</id>
      <url>https://maven.vaadin.com/vaadin-addons</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <!-- Everything Magnolia-related is provided by the Magnolia webapp. -->
    <dependency>
      <groupId>info.magnolia</groupId>
      <artifactId>magnolia-core</artifactId>
      <version>${magnolia.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>info.magnolia</groupId>
      <artifactId>magnolia-templating</artifactId>
      <version>${magnolia.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>info.magnolia.ui</groupId>
      <artifactId>magnolia-ui-framework-jcr</artifactId>
      <version>${magnolia.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>info.magnolia.pages</groupId>
      <artifactId>magnolia-pages-app</artifactId>
      <version>${magnolia.pages.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>info.magnolia.site</groupId>
      <artifactId>magnolia-site</artifactId>
      <version>${magnolia.site.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>vaadin-server-mpr-jakarta</artifactId>
      <version>${vaadin.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>info.magnolia</groupId>
      <artifactId>magnolia-core</artifactId>
      <version>${magnolia.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- Fills ${project.version} into the module descriptor. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>META-INF/magnolia/*.xml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>META-INF/magnolia/*.xml</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <!--
        The Supertext Java SDK, bundled in lib/supertext-sdk (package
        com.supertext.magnolia.translation.internal.sdk, see its README) and compiled into this
        jar, so the jar stays the only file to install. Update it with scripts/vendor-sdk.sh.
        Supertext Plugin Health, bundled the same way in lib/supertext-plugin-health (package
        com.supertext.magnolia.translation.internal.pluginhealth). Update it with
        scripts/vendor-plugin-health.sh.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>supertext-sdk</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>lib/supertext-sdk/src</source>
                <source>lib/supertext-plugin-health/src</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifest>
              <!-- Implementation-Version: shown in the Supertext app and sent as User-Agent. -->
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-install-plugin</artifactId>
        <version>3.2.0</version>
      </plugin>
    </plugins>
  </build>
</project>
