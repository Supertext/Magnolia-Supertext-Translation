<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module SYSTEM "module.dtd">
<module>
  <name>supertext-translation</name>
  <displayName>Supertext Translation</displayName>
  <description>Translates pages with Supertext AI: "Translate with Supertext" in the Pages app, settings in Translation → Supertext.</description>
  <class>com.supertext.magnolia.translation.SupertextTranslationModule</class>
  <version>${project.version}</version>

  <components>
    <id>main</id>
    <component>
      <type>com.supertext.magnolia.translation.SupertextSettings</type>
      <implementation>com.supertext.magnolia.translation.SupertextSettings</implementation>
      <scope>singleton</scope>
    </component>
    <component>
      <type>com.supertext.magnolia.translation.api.SupertextClient</type>
      <implementation>com.supertext.magnolia.translation.api.SupertextClient</implementation>
      <scope>singleton</scope>
    </component>
  </components>

  <!-- Options of the "Translate into" checkboxes (datasource name: supertext-target-languages). -->
  <components>
    <id>datasource-supertext-target-languages</id>
    <component>
      <type>info.magnolia.ui.field.SelectFieldSupport</type>
      <implementation>com.supertext.magnolia.translation.ui.TargetLanguagesSelectFieldSupport</implementation>
    </component>
    <component>
      <type>com.vaadin.data.provider.ListDataProvider</type>
      <implementation>com.supertext.magnolia.translation.ui.TargetLanguagesDataProvider</implementation>
    </component>
  </components>

  <dependencies>
    <dependency>
      <name>core</name>
      <version>6.4/*</version>
    </dependency>
    <dependency>
      <name>ui-framework-jcr</name>
      <version>6.4/*</version>
    </dependency>
    <dependency>
      <name>pages-app</name>
      <version>6.4/*</version>
    </dependency>
    <dependency>
      <name>site</name>
      <version>3.0/*</version>
    </dependency>
  </dependencies>
</module>
